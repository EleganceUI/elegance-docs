---
// An example from the elegance-examples repository (see scripts/paths.mjs): its screenshot and
// full source, read at build time so the page always shows the code that compiles. When the
// example also has a Rust version (<name>-rs/src/main.rs), both come under the language switch.
//   <Example name="counter" />
import { Code } from '@astrojs/starlight/components';
import LanguageTabs from './LanguageTabs.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	name: string;
	// Show the source collapsed under the screenshot (for long examples).
	collapsed?: boolean;
}

const { name, collapsed = false } = Astro.props;

const sources = import.meta.glob<string>('@examples/*-cpp/main.cpp', { query: '?raw', import: 'default', eager: true });
const rustSources = import.meta.glob<string>('@examples/*-rs/src/main.rs', { query: '?raw', import: 'default', eager: true });
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/examples/*.png', { eager: true });

// Keyed by where each file resolved to: find it by its folder.
const nameOf = (key: string) => key.match(/([^/]+)-cpp\/main\.cpp$/)![1];
const source = Object.entries(sources).find(([key]) => nameOf(key) === name)?.[1];
if (!source) {
	const known = Object.keys(sources).map(nameOf);
	throw new Error(
		known.length === 0
			? `Example "${name}" not found: check out elegance-examples beside elegance-docs`
			: `Example "${name}" not found in elegance-examples (has ${known.join(', ')})`,
	);
}
// A license header, if an example has one, isn't interesting here; its description comment is.
const code = source.replace(/^(\/\/.*\r?\n)*\/\/.*License.*\r?\n(\/\/.*\r?\n)*\r?\n/, '');
// Captured on a Retina screen, at twice the size the window is shown at.
const shot = shots[`../assets/examples/${name}.png`]?.default;
const path = `${name}-cpp/main.cpp`;
const rust = Object.entries(rustSources).find(([key]) => key.match(/([^/]+)-rs\/src\/main\.rs$/)![1] === name)?.[1];
const rustPath = `${name}-rs/src/main.rs`;
---

<figure class="elg-example">
	{
		shot && (
			<div class="elg-example-stage">
				<Image src={shot} width={shot.width / 2} densities={[1, 2]} alt={`The ${name} example running`} class="elg-example-shot" />
			</div>
		)
	}
	{
		collapsed ? (
			<details>
				<summary>
					Source: <code class={rust ? 'elg-only-cpp' : undefined}>{path}</code>
					{rust && <code class="elg-only-rust">{rustPath}</code>}
				</summary>
				<div class={rust ? 'elg-lang-pair' : undefined}>
					{rust && <LanguageTabs />}
					<Code code={code} lang="cpp" title={path} />
					{rust && <Code code={rust} lang="rust" title={rustPath} />}
				</div>
			</details>
		) : (
			<div class={rust ? 'elg-lang-pair' : undefined}>
				{rust && <LanguageTabs />}
				<Code code={code} lang="cpp" title={path} />
				{rust && <Code code={rust} lang="rust" title={rustPath} />}
			</div>
		)
	}
</figure>
