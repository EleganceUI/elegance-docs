---
// The home page's banner: what Elegance is and where it runs on the left, the counter's window on
// the right, on a dark band the width of the page. Other pages with a hero (the 404) get Starlight's.
import { Image } from 'astro:assets';
import Default from '@astrojs/starlight/components/Hero.astro';
import counter from '../assets/examples/counter.png';

const { id, data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const home = id === '' || id === 'index';
---

{!home && <Default />}
{
	home && (
		<div class="elg-hero not-content">
			<div class="elg-hero-inner">
				<div class="elg-hero-copy">
					<p class="elg-hero-eyebrow">Framework</p>
					<h1 id="_top" data-page-title set:html={title} />
					{tagline && <p class="elg-hero-tagline" set:html={tagline} />}
					<dl class="elg-hero-facts">
						<div><dt>Languages</dt><dd>C++23, Rust</dd></div>
						<div><dt>Platforms</dt><dd>Windows, macOS, Linux</dd></div>
						<div><dt>Renderer</dt><dd>WebGPU</dd></div>
					</dl>
					{
						actions.length > 0 && (
							<p class="elg-hero-actions">
								{actions.map(({ link: href, text }) => (
									<a {href}>{text}</a>
								))}
							</p>
						)
					}
				</div>
				<Image src={counter} alt="The counter example running in its own window" class="elg-hero-shot" loading="eager" />
			</div>
		</div>
	)
}
