---
// The C++/Rust switch in the header (in the menu on small screens): every code sample and
// language-specific note on the site follows it (src/scripts/language.mjs). Stands in for
// Starlight's SocialIcons, which is what sits in that spot.
---

<div class="elg-lang-picker">
	<span class="elg-lang-picker-label">Language</span>
	<div class="elg-lang-segments" role="group" aria-label="Code samples in">
		<button type="button" data-set-lang="cpp">C++</button>
		<button type="button" data-set-lang="rust">Rust</button>
	</div>
</div>
