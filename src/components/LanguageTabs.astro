---
// The C++/Rust tabs on a sample in both languages; the same markup remark-language-pairs.mjs
// writes for Markdown code blocks.
---

<div class="elg-lang-tabs" role="group" aria-label="Language">
	<button type="button" data-set-lang="cpp" class="elg-lang-tab">C++</button>
	<button type="button" data-set-lang="rust" class="elg-lang-tab">Rust</button>
</div>
